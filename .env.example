NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<password>
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=<instance-id>
AURA_INSTANCENAME=rationode
ANTHROPIC_API_KEY=<anthropic-api-key>
DEMO_ACCESS_CODE=<access-code>

# Databricks (optional; can be entered in Settings instead, which takes precedence)
DATABRICKS_HOST=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_SCHEMA=
DATABRICKS_TOKEN=

# Encrypts tokens saved in Settings. Generate: openssl rand -base64 32. Changing it makes saved tokens unreadable.
SETTINGS_KEY=

# Workspaces this deployment serves (id:name, comma-separated); the workspace dropdown lists them.
RATIONODE_WORKSPACES=history:Streamly demo
# Optional: a workspace's own access code (opens only that workspace at /<id>); DEMO_ACCESS_CODE opens all.
RATIONODE_WORKSPACE_CODES=
